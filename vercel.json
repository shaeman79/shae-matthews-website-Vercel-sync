{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/shae-matthews/home",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/journal",
      "destination": "/journal/index.html"
    }
  ],
  "headers": [
    {
      "source": "/journal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
